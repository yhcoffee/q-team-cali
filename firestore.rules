rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function manager() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/authorizedManagers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/authorizedManagers/$(request.auth.uid)).data.active == true;
    }
    match /authorizedManagers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /calibration/team {
      allow get: if manager();
      allow create, update: if manager() &&
        request.resource.data.keys().hasOnly(['payload','updatedAt']) &&
        request.resource.data.payload is map &&
        request.resource.data.payload.people is list &&
        request.resource.data.payload.assessments is list;
      allow list, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
